---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { interests, site } from '../data/site';
---

<BaseLayout>
  <div class="page-shell">
    <Header />

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">Academic homepage · Personal archive</p>
        <h1 id="hero-title">
          Curious about ideas.<br />
          Serious about <em>making them real.</em>
        </h1>
        <p class="hero-copy">
          I’m building this space to collect my research, projects, and notes.
          The first version is intentionally simple; the work will give it shape.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work</a>
          <a class="text-link" href={site.github} target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="intro-grid" id="about" aria-labelledby="about-title">
        <div>
          <p class="section-number">01</p>
          <h2 id="about-title">About</h2>
        </div>
        <div class="section-copy">
          <p class="lead">
            This is the starting point for a long-term personal and academic website.
          </p>
          <p>
            Add your real name, institution, research direction, and a short biography
            here. The layout is ready to grow without changing the foundation.
          </p>
        </div>
      </section>

      <section id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="section-number">02</p>
            <h2 id="work-title">Current directions</h2>
          </div>
          <p>Replace these placeholders as your profile takes shape.</p>
        </div>

        <ol class="direction-list">
          {interests.map((interest, index) => (
            <li>
              <span>0{index + 1}</span>
              <h3>{interest}</h3>
              <span class="arrow" aria-hidden="true">↗</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <p class="section-number">03</p>
        <h2 id="contact-title">Let’s connect.</h2>
        <p>For now, you can find my work and activity on GitHub.</p>
        <a class="button button-light" href={site.github} target="_blank" rel="noreferrer">
          Visit GitHub <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
